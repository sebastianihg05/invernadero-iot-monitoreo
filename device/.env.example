# Copiar este archivo como ".env" (junto al docker-compose.yml) y completar.
# El archivo ".env" NO se sube a GitHub. El token es un secreto.

# URL de la API en Vercel (debe ser https y terminar en /api/sensores)
API_URL=https://invernadero-iot-monitoreo.vercel.app/api/sensores

# Mismo valor que la variable DEVICE_SECRET_TOKEN configurada en Vercel
DEVICE_TOKEN=
